NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production: NEXT_PUBLIC_API_BASE_URL=/backend and BACKEND_URL=https://your-service.onrender.com
# Keep BACKEND_URL server-side; it configures the same-origin API proxy.
# NEXT_PUBLIC_SITE_URL=https://shiftai-five.vercel.app
# Optional: also set the SAME ID in backend/.env. No Google client secret is needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional override; the built-in email login works at /auth/login by default.
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login
