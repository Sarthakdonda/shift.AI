GEMINI_API_KEY=
# Optional comma-separated backup keys, tried after the primary key.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Default reasoning effort when a project has not chosen one: instant, low, medium, high.
GEMINI_EFFORT=low
# Optional for Gemini 3 models: overrides effort. Leave unset to use GEMINI_EFFORT.
# GEMINI_THINKING_LEVEL=low
MONGODB_URI=
MONGODB_DATABASE=shift_ai
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_MB=15
GOOGLE_CLIENT_ID=
SESSION_SECRET=
COOKIE_SECURE=false
# Local single-user access is available until Google sign-in is configured.
ALLOW_LOCAL_ACCESS=true
VECTOR_SEARCH_ENABLED=false
VECTOR_INDEX_NAME=document_embeddings
EMBEDDING_MODEL=gemini-embedding-001
