GEMINI_API_KEY=
# Optional comma-separated backup keys, tried after the primary key.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Default reasoning effort when a project has not chosen one: instant, low, medium, high.
GEMINI_EFFORT=low
# Optional for Gemini 3 models: overrides effort. Leave unset to use GEMINI_EFFORT.
# GEMINI_THINKING_LEVEL=low
# Prototype/application building only (planning, review, translation, sync and repair).
# Keep keys server-side; primary first, then comma-separated backups in order.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_COMPLETION_TOKENS=16000
# Maximum automatic wait when all usable keys are cooling down.
# Groq keys in the same organization share quotas.
GROQ_COOLDOWN_WAIT_SECONDS=120
# Conservative per-stage budgeting; response headers can lower the organization limit.
GROQ_CONTEXT_WINDOW=131072
GROQ_MODEL_OUTPUT_LIMIT=65536
GROQ_TOKENS_PER_MINUTE=8000
GROQ_STAGE_OUTPUT_TOKENS=2048
# Use the server-side Gemini key pool for builder stages when Groq is unavailable.
# This uses Gemini quota; it does not increase Groq organization limits.
# Keys belonging to the same Google project also share that project's quota.
BUILDER_GEMINI_FALLBACK=true
MONGODB_URI=
MONGODB_DATABASE=shift_ai
# Keep Atlas TLS/selection recovery bounded without failing on a brief Wi-Fi delay.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=20000
MONGODB_CONNECT_TIMEOUT_MS=15000
MONGODB_SOCKET_TIMEOUT_MS=30000
# 3000/3001 serve the website; 3100 serves the phone app frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100
MAX_UPLOAD_MB=15
GOOGLE_CLIENT_ID=
SESSION_SECRET=
COOKIE_SECURE=false
# Require account sign-in. Local bypass is reserved for isolated test fixtures.
ALLOW_LOCAL_ACCESS=false
VECTOR_SEARCH_ENABLED=false
VECTOR_INDEX_NAME=document_embeddings
EMBEDDING_MODEL=gemini-embedding-001
# Public address of the frontend; used in password reset links when no allowed Origin is sent.
APP_BASE_URL=http://localhost:3000
# Password reset email. Leave SMTP_HOST empty to keep the local link fallback during setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=shift.AI
SMTP_STARTTLS=true
PASSWORD_RESET_MINUTES=30
# Without SMTP, show the reset link only to loopback callers. Set false to disable that fallback.
PASSWORD_RESET_LOCAL_LINK=true

# Generated application deployment. Tokens remain server-side.
RENDER_API_KEY=
# Bind each project to its own preconfigured image-backed Render service and registry.
# Example: {"PROJECT_ID":{"service_id":"srv-...","image_repository":"ghcr.io/your-org/your-app"}}
RENDER_TARGETS_JSON={}
# Local previews require a running Docker Engine and python:3.13-slim pulled in advance.
# Disable on remote deployments until a separate authenticated preview origin is configured.
APPLICATION_PREVIEW_ENABLED=true
# Optional Vercel frontend. The persistent backend/database stay on Render.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# One-click deployment of generated applications. See docs/builder-deployment.md.
# Generated backends per application; 'free' services sleep when idle.
RENDER_OWNER_ID=
RENDER_REGION=singapore
RENDER_PLAN=free
# This origin plus /api/deploy/github/callback must be registered as a Callback URL
# on the GitHub App, so repository creation can be authorized by GITHUB_OWNER.
DEPLOY_CALLBACK_ORIGIN=http://localhost:8000
DEPLOY_POLL_SECONDS=10
DEPLOY_TIMEOUT_MINUTES=25
BUILDER_ENABLED=true
BUILDER_TIMEOUT_SECONDS=180
BUILDER_INITIAL_CREDITS=100
BUILDER_BUILD_COST=10
# Comma-separated existing user IDs allowed to administer plans/credits/monitoring.
# Workspace administrators do not automatically get platform billing privileges.
BUILDER_ADMIN_IDS=

# Razorpay checkout. Use TEST keys; never expose the secret in frontend env.
RAZORPAY_MODE=test
RAZORPAY_LIVE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_BUSINESS_NAME=shift.AI
RAZORPAY_MINIMUM_AMOUNT=1.00
# One-time Starter credit pack: 9900 paise = INR 99; no automatic renewal.
# Set true after adding matching test keys. No recurring plan ID is required.
RAZORPAY_CREDIT_PACKS_ENABLED=false
RAZORPAY_CREDIT_PACK_AMOUNT=9900
RAZORPAY_CREDIT_PACK_CREDITS=100
# Subscribe to payment.captured and order.paid at /api/billing/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=
# Create an INR recurring plan in Razorpay TEST mode, then map its plan ID here.
# Example: {"starter":{"name":"Starter","plan_id":"plan_REPLACE","credits":100}}
RAZORPAY_PLANS_JSON={}

# Durable Mongo queue. For a separate worker set false and run python -m app.worker.
BUILDER_JOB_MODE=durable
PORTABLE_PREVIEW_ORIGIN=http://localhost:8000
# Per-project subdomains of this host must reach the backend. Use a separate HTTPS
# domain in production; local *.localhost previews remain on this machine.
NATIVE_WORKER_TARGETS=
NATIVE_ARTIFACT_DIR=.local/application-artifacts
NATIVE_BUILD_TIMEOUT=1200
# Provision locked dependencies on dedicated hosts; keep normal builds offline.
NATIVE_DEPENDENCY_NETWORK=false
NATIVE_APPLE_TEAM=
WORKER_EMBEDDED=true
# Dedicated HTTPS hostname running app.preview_gateway:app, separate from app/API hosts.
PREVIEW_PUBLIC_ORIGIN=
API_PUBLIC_ORIGIN=
# Build locally: docker build -t shift-document-converter:1 backend/containers/documents
DOCUMENT_CONVERTER_IMAGE=shift-document-converter:1
DOCUMENT_OCR_LANGUAGES=eng+hin+guj

# Optional enterprise OIDC (RS256, code flow, client_secret_basic, PKCE).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Comma-separated verified email domains permitted to sign in; blank allows issuer members.
OIDC_EMAIL_DOMAINS=
