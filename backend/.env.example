GEMINI_API_KEY=
# Optional comma-separated backup keys, tried after the primary key.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Default reasoning effort when a project has not chosen one: instant, low, medium, high.
GEMINI_EFFORT=low
# Optional for Gemini 3 models: overrides effort. Leave unset to use GEMINI_EFFORT.
# GEMINI_THINKING_LEVEL=low
MONGODB_URI=
MONGODB_DATABASE=shift_ai
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_MB=15
GOOGLE_CLIENT_ID=
SESSION_SECRET=
COOKIE_SECURE=false
# Require account sign-in. Local bypass is reserved for isolated test fixtures.
ALLOW_LOCAL_ACCESS=false
VECTOR_SEARCH_ENABLED=false
VECTOR_INDEX_NAME=document_embeddings
EMBEDDING_MODEL=gemini-embedding-001
# Public address of the frontend; used in password reset links when no allowed Origin is sent.
APP_BASE_URL=http://localhost:3000
# Password reset email. Leave SMTP_HOST empty to keep the local link fallback during setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=shift.AI
SMTP_STARTTLS=true
PASSWORD_RESET_MINUTES=30
# Without SMTP, show the reset link only to loopback callers. Set false to disable that fallback.
PASSWORD_RESET_LOCAL_LINK=true
