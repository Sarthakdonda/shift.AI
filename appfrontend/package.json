{
  "name": "shift-ai-appfrontend",
  "version": "1.0.0",
  "private": true,
  "description": "Native-feeling mobile app frontend for the Shift AI Android shell. Shares the backend with the website in ../frontend.",
  "scripts": {
    "dev": "next dev --port 3100",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3100",
